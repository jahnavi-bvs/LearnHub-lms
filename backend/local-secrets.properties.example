# LearnHub LMS - local secrets TEMPLATE
#
# 1. Copy this file to "local-secrets.properties" in the same folder (backend/).
# 2. Fill in the values below.
# The real file is listed in .gitignore and must never be committed or shared.

# MySQL user that owns the learnhub_* databases
DB_USERNAME=learnhub
DB_PASSWORD=

# Key that signs and verifies JWTs: base64, at least 32 random bytes. Same value for all services.
# Generate one with (Git Bash):  openssl rand -base64 48
JWT_SECRET=

# Password for the first admin account (admin@learnhub.com), at least 8 characters.
# Created once, when auth-service starts. Changing it here later does not change the account.
ADMIN_PASSWORD=
